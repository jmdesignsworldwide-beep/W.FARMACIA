# ════════════════════════════════════════════════════════════════════
# W.FARMACIA — Variables de entorno
# ────────────────────────────────────────────────────────────────────
# Museo de Errores #4: lista exacta para copiar y pegar. El código las
#   verifica al arrancar y falla ruidosamente si falta o está mal (src/lib/env.ts).
# Museo de Errores #5: TODAS del MISMO proyecto de Supabase, en una sola
#   sentada. Nunca mezcles la URL de un proyecto con la llave de otro.
# Museo de Errores #6: al copiar las llaves, cuida no arrastrar espacios
#   ni caracteres invisibles — la validación de formato lo detecta.
# ════════════════════════════════════════════════════════════════════

# URL del proyecto (Supabase → Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://TU_REF.supabase.co

# Llave pública anónima (Settings → API → Project API keys → anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Llave de servicio — SOLO servidor, NUNCA con prefijo NEXT_PUBLIC.
# (Settings → API → Project API keys → service_role). Necesaria para tareas
# administrativas del lado servidor; el sistema arranca sin ella para el flujo normal.
SUPABASE_SERVICE_ROLE_KEY=
